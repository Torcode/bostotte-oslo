# =============================================================================
# Hva som IKKE hører hjemme i repoet.
#
# Regelen: alt `quarto render` lager på nytt, holdes utenfor — med ett bevisst
# unntak, se PDF-en nedenfor.
# =============================================================================

# --- R / RStudio ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# --- Posit / editor ---
.posit/
.vscode/

# --- Quarto- og knitr-artefakter (regenereres ved hver rendering) ---
/.quarto/
/_freeze/
*_cache/
*_files/
*.knit.md
*.rmarkdown
/bostotte_oslo.html
/bostotte_oslo.typ

# NB: bostotte_oslo.pdf er bevisst IKKE ignorert. Den ferdige rapporten
# versjoneres, slik at en leser ser resultatet uten å installere R, Quarto og
# ni pakker først. Prisen er at den må bygges på nytt før hver innlevering,
# ellers ligger den i utakt med kilden.

# --- Store binærfiler som ikke trengs ---
# Datapakke-zip (redundant med utpakket data/)
*.zip

# --- Python-bytekode og CI-artefakter (regenereres) ---
__pycache__/
*.py[cod]
/artifacts/

# --- Lokale opprydningsmapper (skal aldri versjoneres) ---
_to_delete/

# --- OS ---
.DS_Store
Thumbs.db
