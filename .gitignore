# --- R / RStudio ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*_cache/

# --- Posit / editor ---
.posit/
.vscode/

# --- Quarto render-artefakter (regenereres) ---
# NB: bostotte_oslo.pdf er IKKE ignorert. Den ferdige rapporten versjoneres,
# slik at en leser ser resultatet uten å installere R og Quarto.
/.quarto/
/bostotte_oslo.html
/bostotte_oslo.typ
/bostotte_oslo.knit.md
/bostotte_oslo_files/
/*_files/
*.knit.md

# --- Store binærfiler som ikke trengs i repoet ---
# Datapakke-zip (redundant med utpakket velferdsetaten-data/)
*.zip

# --- OS ---
.DS_Store
Thumbs.db

# --- Python-bytekode (regenereres av tolkeren) ---
__pycache__/
*.py[cod]

# --- Quarto/Typst-artefakter (regenereres av `quarto render`) ---
/bostotte_oslo.typ

# --- Lokale opprydningsmapper (skal aldri versjoneres) ---
_to_delete/

# --- Quarto/knitr-cache (regenereres) ---
/_freeze/
/bostotte_oslo_cache/
